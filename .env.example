# Backend Environment Configuration Template

# Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/sdfds_db
SPRING_DATASOURCE_USERNAME=sdfds_user
SPRING_DATASOURCE_PASSWORD=sdfds_password

# Redis Configuration
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379

# JWT Security
JWT_SECRET=your_secure_256bit_secret_key_here_change_in_production

# Mail Configuration (Optional - set APP_MAIL_ENABLED=true for real SMTP)
APP_MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password

# URLs and CORS
SERVER_PORT=8081
APP_FRONTEND_URL=http://localhost:5173
APP_PUBLIC_BACKEND_URL=http://localhost:8081
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# AWS S3 Storage (For AWS Production Mode)
STORAGE_BACKEND=local
AWS_REGION=us-east-1
AWS_S3_BUCKET_PRIMARY=atlas-storage-node-1
AWS_S3_BUCKET_SECONDARY=atlas-storage-node-2
AWS_S3_BUCKET_TERTIARY=atlas-storage-node-3
